# Agente IA Autónomo — variables de entorno (opcional en modo demo)

# LLM opcional para mejorar diagnosis/pitch (no obligatorio en demo)
GROK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Modelo preferido si hay API key
LLM_MODEL=grok-2-latest
LLM_BASE_URL=https://api.x.ai/v1

# Producción (futuro)
# GOOGLE_PLACES_API_KEY=
# CALENDLY_LINK=https://calendly.com/tu-agencia/diagnostico
# SENDER_EMAIL=
# SENDER_NAME=Agente IA Autónomo

# Umbral human-in-the-loop (CLP)
HITL_VALUE_CLP=2800000
HITL_RESPONSE_RATE=0.12

# Modo: demo | prod
APP_MODE=demo
