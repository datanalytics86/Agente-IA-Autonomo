# Copia canónica. engine/.env.example debe ser idéntico.
# Demo arranca con todo vacío. No inventar identidad de la agencia.
# No commitear .env

# --- Modo (seguro por defecto) ---
APP_MODE=demo
DRY_RUN=true
OUTREACH_ENABLED=false
TZ=America/Santiago
VIDEO_ENABLED=true

# --- Núcleo ---
DATABASE_URL=sqlite:///./state/agencia.db
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=http://localhost
ADMIN_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:4321

# --- Agencia (placeholders vacíos) ---
AGENCY_NAME=
AGENCY_LEGAL_NAME=
AGENCY_RUT=
AGENCY_EMAIL=
AGENCY_ADDRESS=

# --- LLM (xAI, OpenAI-compatible). GROK_API_KEY es alias de XAI_API_KEY ---
XAI_API_KEY=
GROK_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
LLM_MODEL_FAST=grok-4.6
LLM_DAILY_BUDGET_USD=3

# --- Datos ---
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
SCOUT_COMMUNES=Providencia,Las Condes,Ñuñoa,Maipú,Viña del Mar,Valparaíso,Concepción,Temuco,La Serena
SCOUT_CATEGORIES=clinica-dental,optica,abogados,estudio-contable,peluqueria,centro-estetica,spa,gimnasio,cafeteria,restaurante,taller-mecanico,inmobiliaria,veterinaria,escuela-idiomas,ferreteria
SCOUT_DAILY_LIMIT=30
SCOUT_MIN_RATING=4.0
SCOUT_MIN_REVIEWS=15
DIAGNOSE_DAILY_LIMIT=15

# --- Email: transaccional (nunca outreach en frío) y buzón dedicado ---
RESEND_API_KEY=
EMAIL_TX_FROM=
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASSWORD=
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=
OUTREACH_FROM=
EMAIL_OUTREACH_DAILY_LIMIT=15
EMAIL_OUTREACH_DAILY_MAX=50
FOLLOWUP_1_BUSINESS_DAYS=4
FOLLOWUP_2_BUSINESS_DAYS=9

# --- Agenda ---
BOOKING_PROVIDER=calcom
BOOKING_LINK=
CALENDLY_LINK=
CALCOM_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Pagos ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PRICES_INCLUDE_IVA=true
DEPOSIT_PERCENT=50
PRICE_MIN_CLP=250000
PRICE_MAX_CLP=450000
MAINTENANCE_PRICE_CLP=

# --- Meta (solo inbound) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Seguridad ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# --- Hosting ---
HOSTING_PROVIDER=caddy
CLIENT_SITES_DIR=engine/output/clients
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Avisos ---
NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- HITL y retención ---
HITL_VALUE_CLP=2800000
HITL_RESPONSE_RATE=0.12
HITL_MIN_SAMPLE=30
MOBILE_AUTOREPLY_MIN_CONFIDENCE=0.8
DEMO_TTL_DAYS=30
RETENTION_DAYS=120
JOB_MAX_RETRIES=3
