# Sitio Astro + dashboard. Contexto: raíz del repo.
# El dist no se monta desde el host: queda dentro de la imagen caddy.
# `vite build --base=/admin/` aunque apps/web (B5) todavía no fije el base.

FROM node:22-bookworm-slim AS site

WORKDIR /src
ENV CI=true \
    ASTRO_TELEMETRY_DISABLED=1
COPY apps/site/package.json apps/site/package-lock.json ./
RUN npm ci
COPY apps/site/ ./
ARG PUBLIC_BASE_URL=http://localhost
ENV PUBLIC_BASE_URL=${PUBLIC_BASE_URL}
RUN npm run build

FROM node:22-bookworm-slim AS web

WORKDIR /src
ENV CI=true
COPY apps/web/package.json apps/web/package-lock.json ./
# openapi-typescript 7 pide TypeScript 5 y el dashboard usa TypeScript 6.
# El lockfile ya resuelve el árbol; sin esta bandera npm 11 aborta el peer.
RUN npm ci --legacy-peer-deps
COPY apps/web/ ./
RUN npx tsc -b && npx vite build --base=/admin/

FROM caddy:2

COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=site /src/dist /srv/site
COPY --from=web /src/dist /srv/admin
