# Demo y CI, solo HTTP. TLS y on-demand de clientes: Caddyfile.prod.
# SITE_DOMAIN y ADMIN_DOMAIN llegan por el entorno del contenedor.
# /healthz y /readyz van a la API. El sitio estático no puede taparlos.

{
	admin off
	auto_https off
	on_demand_tls {
		ask http://api:8000/api/internal/domain-check
	}
}

:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	redir /admin /admin/ 308

	@clients {
		not host {$SITE_DOMAIN:localhost}
		not host {$ADMIN_DOMAIN:localhost}
		not host localhost
		not host 127.0.0.1
	}
	handle @clients {
		root * /srv/clients/{http.request.host}
		try_files {path} {path}/index.html
		file_server
	}

	@health path /healthz /readyz
	handle @health {
		reverse_proxy api:8000
	}

	@demo path /demo /demo/*
	handle @demo {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8000
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}

	@webhooks path /webhooks /webhooks/*
	handle @webhooks {
		reverse_proxy api:8000
	}

	@ficha path /u /u/*
	handle @ficha {
		reverse_proxy api:8000
	}

	@admin path /admin /admin/*
	handle @admin {
		uri strip_prefix /admin
		root * /srv/admin
		try_files {path} {path}/index.html /index.html
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
