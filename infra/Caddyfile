# Sitio público en /. /api, /webhooks, /demo y /u van a la api.
# /admin va al dashboard estático (servicio web).
# X-Robots-Tag solo en /demo, no en el resto del sitio.
# HSTS solo en el sitio TLS de prueba (127.0.0.1 y localhost). Sin preload.
# disable_redirects deja el :80 en HTTP. auto_https off rompe tls internal
# (handshake "tlsv1 alert internal error").
{
	admin off
	auto_https disable_redirects
	# curl a la IP no manda SNI. Sin esto el handshake del :443 publicado
	# responde "tlsv1 alert internal error".
	default_sni 127.0.0.1
}

(agencia) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	@health path /healthz /readyz
	handle @health {
		reverse_proxy api:8000
	}

	@demo path /demo /demo/*
	handle @demo {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8000
	}

	# No se publica. Caddy llama a http://api:8000/api/internal/domain-check
	# por la red de Compose. El sitio :80 responde 404, también si el path
	# cambia de mayúsculas, trae %2F o un segmento ".".
	@internal path_regexp (?i)^/+api(?:/|\.|%2[fF])*internal(?:/|$)
	handle @internal {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}

	@webhooks path /webhooks /webhooks/*
	handle @webhooks {
		reverse_proxy api:8000
	}

	@ficha path /u /u/*
	handle @ficha {
		reverse_proxy api:8000
	}

	handle /admin {
		redir * /admin/ 308
	}

	handle /admin/* {
		uri strip_prefix /admin
		reverse_proxy web:80
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}

http://:80 {
	import agencia
}

https://127.0.0.1, https://localhost {
	import agencia
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	tls internal
}
