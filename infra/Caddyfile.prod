# TLS de producción con ACME. No usa tls internal.
# On-demand TLS de sitios de clientes queda apagado.
# HSTS solo en este archivo: max-age=31536000; includeSubDomains, sin preload.
# www, panel y api piden certificado: esos DNS tienen que existir antes del primer up.
{
	email {$ACME_EMAIL}
	admin off
}

(noauth) {
}

# STAGING_HASH es un hash bcrypt. En el .env va entre comillas simples,
# STAGING_HASH='$2a$...', porque si no el shell se come los $.
# Si el valor se escribe en un compose, cada $ se escribe $$.
(staging_auth) {
	basic_auth {
		{$STAGING_USER} {$STAGING_HASH}
	}
}

(agencia) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	@health path /healthz /readyz
	handle @health {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}

	handle {
		import {$EDGE_AUTH:noauth}

		route {
			@demo path /demo /demo/*
			handle @demo {
				header X-Robots-Tag "noindex, nofollow"
				reverse_proxy {$API_UPSTREAM:api:8000}
			}

			@internal path_regexp (?i)^/+api(?:/|\.|%2[fF])*internal(?:/|$)
			handle @internal {
				respond 404
			}

			@api path /api /api/*
			handle @api {
				reverse_proxy {$API_UPSTREAM:api:8000}
			}

			@webhooks path /webhooks /webhooks/*
			handle @webhooks {
				reverse_proxy {$API_UPSTREAM:api:8000}
			}

			@ficha path /u /u/*
			handle @ficha {
				reverse_proxy {$API_UPSTREAM:api:8000}
			}

			@pago_fake path /pago/fake /pago/fake/*
			handle @pago_fake {
				reverse_proxy {$API_UPSTREAM:api:8000}
			}

			handle /admin {
				redir * /admin/ 308
			}

			handle /admin/* {
				uri strip_prefix /admin
				root * /srv/admin
				try_files {path} /index.html
				file_server
			}

			handle {
				root * /srv/site
				@portal {
					path_regexp ^/proyecto/[^/]+/?$
					not path /proyecto/shell /proyecto/shell/
				}
				rewrite @portal /proyecto/shell/
				try_files {path} {path}/
				file_server
			}
		}
	}
}

{$SITE_ADDRESS} {
	import agencia
}

www.{$SITE_DOMAIN} {
	redir {$PUBLIC_ORIGIN}{uri} 308
}

panel.{$SITE_DOMAIN} {
	redir {$PUBLIC_ORIGIN}/admin{uri} 308
}

api.{$SITE_DOMAIN} {
	redir {$PUBLIC_ORIGIN}{uri} 308
}
