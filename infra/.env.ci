# Valores de prueba para el smoke de Docker. No son credenciales reales.
APP_MODE=demo
DRY_RUN=true
OUTREACH_ENABLED=false
TZ=America/Santiago
VIDEO_ENABLED=false

POSTGRES_USER=agencia
POSTGRES_PASSWORD=agencia-ci
POSTGRES_DB=agencia
DATABASE_URL=postgresql+psycopg://agencia:agencia-ci@db:5432/agencia

SECRET_KEY=ci-secret-key-de-prueba-no-es-prod-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=clave-de-prueba
PUBLIC_BASE_URL=http://localhost
ADMIN_BASE_URL=http://localhost/admin
CORS_ORIGINS=http://localhost

AGENCY_NAME=[datos de la agencia]
AGENCY_EMAIL=admin@example.com

SITE_DOMAIN=localhost
ADMIN_DOMAIN=localhost
