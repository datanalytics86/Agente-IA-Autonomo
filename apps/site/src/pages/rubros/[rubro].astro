---
import Base from '../../layouts/Base.astro';
import { findRubro, rubros } from '../../data/rubros';

export function getStaticPaths() {
  return rubros.map((rubro) => ({ params: { rubro: rubro.slug } }));
}

const slug = Astro.params.rubro ?? '';
const rubro = findRubro(slug);
if (!rubro) throw new Error('Rubro desconocido');
const related = rubro.related ? findRubro(rubro.related.slug) : undefined;
---

<Base title={rubro.title} description={rubro.description}>
  <article class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">{rubro.label}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{rubro.title}</h1>
    <p class="mt-4 text-lg text-muted">{rubro.intro}</p>
    {
      rubro.blocks.map((block) => (
        <section class="mt-10">
          <h2 class="text-2xl font-semibold">{block.heading}</h2>
          {block.paragraphs.map((paragraph) => (
            <p class="mt-3 text-muted">{paragraph}</p>
          ))}
          {block.items && (
            <ul class="mt-4 grid gap-2 text-sm">
              {block.items.map((item) => (
                <li class="rounded-xl border border-white/10 bg-elevated px-4 py-3">{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
    {
      related && rubro.related && (
        <p class="mt-10 text-sm text-muted">
          <a class="text-accent underline-offset-4 hover:underline" href={`/rubros/${related.slug}`}>
            {related.label}
          </a>
          . {rubro.related.reason}
        </p>
      )
    }
    <div class="mt-10 flex flex-wrap gap-3">
      <a class="rounded-full bg-accent px-5 py-3 text-sm font-semibold text-surface" href="/diagnostico-gratis">
        Pedir diagnóstico
      </a>
      <a class="rounded-full border border-white/20 px-5 py-3 text-sm font-semibold" href="/paquetes">
        Ver precios
      </a>
    </div>
  </article>
</Base>
