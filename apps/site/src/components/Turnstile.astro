---
const siteKey = String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();
---

{
  siteKey ? (
    <>
      <div class="cf-turnstile" data-sitekey={siteKey}></div>
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer></script>
    </>
  ) : null
}
