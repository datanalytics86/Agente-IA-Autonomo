---
interface Props {
  variant: 'carta' | 'taller' | 'estudio';
}

const { variant } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-white/10 bg-surface p-3" aria-hidden="true">
  {
    variant === 'carta' && (
      <div class="grid gap-2">
        <div class="h-8 rounded bg-accent/30" />
        <div class="grid grid-cols-2 gap-2">
          <div class="h-16 rounded bg-white/10" />
          <div class="h-16 rounded bg-white/10" />
        </div>
        <div class="h-6 w-2/3 rounded bg-white/10" />
      </div>
    )
  }
  {
    variant === 'taller' && (
      <div class="grid grid-cols-[1.4fr_1fr] gap-2">
        <div class="grid gap-2">
          <div class="h-5 w-1/2 rounded bg-accent/40" />
          <div class="h-4 rounded bg-white/10" />
          <div class="h-4 w-4/5 rounded bg-white/10" />
          <div class="h-10 rounded bg-white/10" />
        </div>
        <div class="min-h-24 rounded bg-accent/15" />
      </div>
    )
  }
  {
    variant === 'estudio' && (
      <div class="grid gap-2">
        <div class="h-4 w-1/3 rounded bg-white/15" />
        <div class="h-10 rounded border border-accent/40" />
        <div class="h-10 rounded border border-white/10" />
        <div class="h-10 rounded border border-white/10" />
      </div>
    )
  }
</div>
