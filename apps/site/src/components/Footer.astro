---
import Identity from './Identity.astro';
import { rubros } from '../data/rubros';
---

<footer class="mt-20 border-t border-white/10">
  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12">
    <Identity />
    <nav aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      <a class="text-muted underline-offset-4 hover:underline" href="/privacidad">Privacidad</a>
      <a class="text-muted underline-offset-4 hover:underline" href="/terminos">Términos</a>
      <a class="text-muted underline-offset-4 hover:underline" href="/baja">Baja</a>
      <a class="text-muted underline-offset-4 hover:underline" href="/derechos">Derechos</a>
    </nav>
    <nav aria-label="Rubros">
      <p class="text-sm text-muted">Rubros</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          rubros.map((rubro) => (
            <li>
              <a class="text-ink underline-offset-4 hover:underline" href={`/rubros/${rubro.slug}`}>
                {rubro.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-muted">Sin cookies de terceros ni analítica con cookies.</p>
  </div>
</footer>
