---
import { agency } from '../data/agency';
---

<dl class="grid gap-3 text-sm sm:grid-cols-2">
  <div>
    <dt class="text-muted">Nombre</dt>
    <dd>{agency.name}</dd>
  </div>
  <div>
    <dt class="text-muted">Razón social</dt>
    <dd>{agency.legalName}</dd>
  </div>
  <div>
    <dt class="text-muted">RUT</dt>
    <dd>{agency.rut}</dd>
  </div>
  <div>
    <dt class="text-muted">Representante legal</dt>
    <dd>{agency.representative}</dd>
  </div>
  <div>
    <dt class="text-muted">Dirección</dt>
    <dd>{agency.address}</dd>
  </div>
  <div>
    <dt class="text-muted">Correo</dt>
    <dd>{agency.email}</dd>
  </div>
  <div class="sm:col-span-2">
    <dt class="text-muted">Correo de privacidad</dt>
    <dd>{agency.privacyEmail}</dd>
  </div>
</dl>
