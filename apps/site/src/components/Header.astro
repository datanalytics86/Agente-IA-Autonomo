---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/paquetes', label: 'Paquetes' },
  { href: '/diagnostico-gratis', label: 'Diagnóstico' },
  { href: '/agendar', label: 'Agendar' },
];

function current(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="border-b border-white/10">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4">
    <a href="/" class="text-sm font-semibold tracking-tight text-ink">Landings para pymes</a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current(link.href) ? 'page' : undefined}
                class:list={[
                  'underline-offset-4 hover:underline',
                  current(link.href) ? 'text-accent' : 'text-muted',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
