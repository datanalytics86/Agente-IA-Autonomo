---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { agency, publicApiBase } from '../data/agency';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  portal?: boolean;
  jsonLd?: boolean;
}

const { title, description, noindex = false, portal = false, jsonLd = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = `${title} · ${agency.name}`;
const apiBase = publicApiBase();
---

<!doctype html>
<html lang="es-CL" {...(portal ? { 'data-portal': '1' } : {})}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0c0f" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="api-base" content={apiBase} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={agency.name} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        if (document.documentElement.dataset.portal === '1') return;
        var match = location.pathname.match(/^\/proyecto\/([^/]+)\/?$/);
        if (!match || match[1] === 'shell') return;
        document.documentElement.style.visibility = 'hidden';
        function show() {
          document.documentElement.style.visibility = '';
        }
        function write(html) {
          document.open();
          document.write(html);
          document.close();
        }
        fetch('/proyecto/shell/index.html', { credentials: 'same-origin', cache: 'no-store' })
          .then(function (response) {
            if (response.ok) return response.text();
            return fetch('/proyecto/shell/', { credentials: 'same-origin', cache: 'no-store' }).then(
              function (fallback) {
                if (!fallback.ok) throw new Error('portal');
                return fallback.text();
              },
            );
          })
          .then(write)
          .catch(show);
      })();
    </script>
    {jsonLd && <JsonLd />}
  </head>
  <body class="bg-surface text-ink">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-surface"
      href="#contenido"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <Footer />
    <script src="/site.js" is:inline></script>
  </body>
</html>
